# Copy to .env.local for local development.
# Without all live variables, DataPilot automatically runs in Demo Mode.

# OpenAI-compatible provider (server-only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Supabase URL is safe to expose to browser clients when needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only Supabase credential for legitimate Supabase administration.
# It is not used to execute AI-generated SQL.
SUPABASE_SECRET_KEY=

# Direct Postgres connection for the dedicated datapilot_reader role.
# Keep this secret and never expose it to the browser.
DATAPILOT_READONLY_DB_URL=
